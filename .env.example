# Copy this file to .env and adjust values for your environment.

# --- Application ---
APP_NAME="Audio Transcription Pipeline"
APP_VERSION="1.0.0"
DEBUG=false

# --- File upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# --- Whisper model ---
# Supported sizes: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=small
# "cpu" for CPU-only; "cuda" for NVIDIA GPU
WHISPER_DEVICE=cpu
# "int8" (fastest on CPU), "float16" (GPU), "float32" (most accurate)
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true

# --- Chunk-based processing ---
CHUNK_DURATION_SECONDS=360
CHUNK_OVERLAP_SECONDS=5

# --- Database ---
DATABASE_URL=sqlite:///./transcription.db

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
WORKER_CONCURRENCY=2

# --- Retry policy ---
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=60
